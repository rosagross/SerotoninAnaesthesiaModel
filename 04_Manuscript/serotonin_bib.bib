@article{Wang497,
  title = {Effect of Interstimulus Interval on Visual {{P300}} in {{Parkinson}}\textbraceleft\textbackslash textquoteright\textbraceright s Disease},
  author = {Wang, Lihong and Kuroiwa, Yoshiyuki and Kamitani, Toshiaki and Takahashi, Tatsuya and Suzuki, Yume and Hasegawa, Osamu},
  year = 1999,
  journal = {Journal of Neurology, Neurosurgery \& Psychiatry},
  volume = {67},
  number = {4},
  pages = {497--503},
  publisher = {BMJ Publishing Group Ltd},
  issn = {0022-3050},
  doi = {10.1136/jnnp.67.4.497},
  abstract = {OBJECTIVE Visual event related potentials (ERPs) were studied during an oddball paradigm, to testify whether cognitive slowing in Parkinson\textbraceleft\textbackslash textquoteright\textbraceright s disease exists and to investigate whether cognitive information processing can be influenced by different interstimulus intervals (ISIs) of an oddball task in patients with Parkinson\textbraceleft\textbackslash textquoteright\textbraceright s disease and normal subjects. METHODS ERPs and reaction time were measured in 38 non-demented patients with Parkinson\textbraceleft\textbackslash textquoteright\textbraceright s disease and 24 healthy elderly subjects. A visual oddball paradigm was employed to evoke ERPs, at three different interstimulus (ISI) intervals: ISI(S), 1600 ms; ISI(M), 3100 ms; and ISI(L), 5100 ms. The effect of ISIs on ERPs and reaction time was investigated. RESULTS Compared with the normal subjects, P300 latency at Cz and Pz was significantly delayed after rare target stimuli in patients with Parkinson\textbraceleft\textbackslash textquoteright\textbraceright s disease only at ISI(L). Reaction time was prolonged in patients at all the three ISIs, compared with the normal controls. There was also significantly delayed N200 and reduced P300 amplitude at Cz and/or Pz to rare non-target stimuli in patients at the three ISIs, compared with the normal controls. During rare target visual stimulation, P300 latency and reaction time in the patients with Parkinson\textbraceleft\textbackslash textquoteright\textbraceright s disease and reaction time in the normal subjects were gradually prolonged as the ISI increased. CONCLUSION Prolonged N200 latency to rare non-target stimuli might indicate that automatic cognitive processing was slowed in Parkinson\textbraceleft\textbackslash textquoteright\textbraceright s disease. Cognitive processing reflected by P300 latency to rare target stimuli was influenced by longer ISI in patients with Parkinson\textbraceleft\textbackslash textquoteright\textbraceright s disease.}
}

@article{wangDecisionMakingRecurrent2008,
  title = {Decision {{Making}} in {{Recurrent Neuronal Circuits}}},
  author = {Wang, Xiao Jing},
  year = 2008,
  month = oct,
  journal = {Neuron},
  volume = {60},
  number = {2},
  pages = {215--234},
  publisher = {NIH Public Access},
  issn = {08966273},
  doi = {10.1016/j.neuron.2008.09.034},
  urldate = {2022-01-12},
  abstract = {Decision making has recently emerged as a central theme in neurophysiological studies of cognition, and experimental and computational work has led to the proposal of a cortical circuit mechanism of elemental decision computations. This mechanism depends on slow recurrent synaptic excitation balanced by fast feedback inhibition, which not only instantiates attractor states for forming categorical choices but also long transients for gradually accumulating evidence in favor of or against alternative options. Such a circuit endowed with reward-dependent synaptic plasticity is able to produce adaptive choice behavior. While decision threshold is a core concept for reaction time tasks, it can be dissociated from a general decision rule. Moreover, perceptual decisions and value-based economic choices are described within a unified framework in which probabilistic choices result from irregular neuronal activity as well as iterative interactions of a decision maker with an uncertain environment or other unpredictable decision makers in a social group. \copyright{} 2008 Elsevier Inc. All rights reserved.},
  pmid = {18957215},
  file = {C:\Users\gross\Zotero\storage\U5WPVX9N\full-text.pdf}
}

@article{wangEarlyLateStage2017,
  title = {Early and Late Stage Processing Abnormalities in Autism Spectrum Disorders: {{An ERP}} Study},
  author = {Wang, Shanshan and Yang, Chunjuan and Liu, Yijun and Shao, Zhi and Jackson, Todd},
  year = 2017,
  month = may,
  journal = {PLoS ONE},
  volume = {12},
  number = {5},
  publisher = {Public Library of Science},
  issn = {19326203},
  doi = {10.1371/journal.pone.0178542},
  urldate = {2021-01-23},
  abstract = {This research assessed event-related potentials (ERPs) elicited during the processing of different kinds of visual stimuli among children with Autism Spectrum Disorder (ASD) (n = 15) and typically developing (TD) children (n = 19). Within a simple visual oddball paradigm, participating children passively viewed fruit and vegetable images that were used as standard stimuli in addition to images of these foods with their usual colors modified to create novel stimuli and cartoon depictions of these images (i.e., "deviant" stimuli). Analyses revealed significant main effect differences between the groups for P100, N100 and P300 components; ASD group children showing longer P100 latencies, weaker N100 amplitudes and larger P300 amplitudes than did the TD group. A Group x Hemisphere interaction also emerged for N400 amplitudes but differences were not significant in simple-effects analyses. Together these results suggested children with ASD may be characterized by lower attention resource allocation and engagement during early stages of processing visual stimuli. However, ERPs in later processing stages suggested children with ASD and TD children have similar neural responses in attending to visual images as stimulus presentations continue.},
  pmid = {28542618},
  keywords = {Attention / physiology,Autism Spectrum Disorder / physiopathology*,Autism Spectrum Disorder / psychology,Case-Control Studies,Child,Chunjuan Yang,doi:10.1371/journal.pone.0178542,Electroencephalography,Evoked Potentials,Female,Humans,Male,MEDLINE,National Center for Biotechnology Information,National Institutes of Health,National Library of Medicine,NCBI,NIH,NLM,Photic Stimulation,PMC5443563,pmid:28542618,Preschool,PubMed Abstract,Shanshan Wang,Todd Jackson,Visual / physiology*}
}

