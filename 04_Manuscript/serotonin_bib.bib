  issn = {00144819},
  doi = {10.1007/S00221-009-2124-7/FIGURES/5},
  urldate = {2022-10-19},
  abstract = {At present there is a debate on the number of body representations in the brain. The most commonly used dichotomy is based on the body image, thought to underlie perception and proven to be susceptible to bodily illusions, versus the body schema, hypothesized to guide actions and so far proven to be robust against bodily illusions. In this rubber hand illusion study we investigated the susceptibility of the body schema by manipulating the amount of stimulation on the rubber hand and the participant's hand, adjusting the postural configuration of the hand, and investigating a grasping rather than a pointing response. Observed results showed for the first time altered grasping responses as a consequence of the grip aperture of the rubber hand. This illusion-sensitive motor response challenges one of the foundations on which the dichotomy is based, and addresses the importance of illusion induction versus type of response when investigating body representations. \copyright{} 2009 The Author(s).},
  pmid = {20039029},
  keywords = {Action,Body image,Body schema,Perception,Rubber hand illusion},
  file = {C:\Users\gross\Zotero\storage\GNTTYFHY\full-text.pdf}
}

