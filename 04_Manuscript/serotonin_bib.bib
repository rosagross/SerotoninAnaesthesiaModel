@article{ehrssonTouchingRubberHand2005,
  title = {Touching a Rubber Hand: Feeling of Body Ownership Is Associated with Activity in Multisensory Brain Areas},
  author = {Ehrsson, H. Henrik and Holmes, Nicholas P. and Passingham, Richard E.},
  year = 2005,
  month = nov,
  journal = {The Journal of neuroscience : the official journal of the Society for Neuroscience},
  volume = {25},
  number = {45},
  pages = {10564--10573},
  publisher = {J Neurosci},
  issn = {1529-2401},
  doi = {10.1523/JNEUROSCI.0800-05.2005},
  urldate = {2022-10-24},
  abstract = {In the "rubber-hand illusion," the sight of brushing of a rubber hand at the same time as brushing of the person's own hidden hand is sufficient to produce a feeling of ownership of the fake hand. We shown previously that this illusion is associated with activity in the multisensory areas, most notably the ventral premotor cortex (Ehrsson et al., 2004). However, it remains to be demonstrated that this illusion does not simply reflect the dominant role of vision and that the premotor activity does not reflect a visual representation of an object near the hand. To address these issues, we introduce a somatic rubber-hand illusion. The experimenter moved the blindfolded participant's left index finger so that it touched the fake hand, and simultaneously, he touched the participant's real right hand, synchronizing the touches as perfectly as possible. After {$\sim$}9.7 s, this stimulation elicited an illusion that one was touching one's own hand. We scanned brain activity during this illusion and two control conditions, using functional magnetic resonance imaging. Activity in the ventral premotor cortices, intraparietal cortices, and the cerebellum was associated with the illusion of touching one's own hand. Furthermore, the rated strength of the illusion correlated with the degree of premotor and cerebellar activity. This finding suggests that the activity in these areas reflects the detection of congruent multisensory signals from one's own body, rather than of visual representations. We propose that this could be the mechanism for the feeling of body ownership. Copyright \copyright{} 2005 Society for Neuroscience.},
  pmid = {16280594},
  keywords = {Adult,Brain / anatomy & histology,Brain / blood supply,Brain / physiology*,Brain Mapping*,Comparative Study,Computer-Assisted / methods,doi:10.1523/JNEUROSCI.0800-05.2005,Female,Functional Laterality / physiology,H Henrik Ehrsson,Hand / physiology*,Human Body,Humans,Illusions / psychology,Image Processing,Linear Models,Magnetic Resonance Imaging / methods,Male,MEDLINE,Middle Aged,Movement / physiology,National Center for Biotechnology Information,National Institutes of Health,National Library of Medicine,NCBI,Nicholas P Holmes,NIH,NLM,Non-U.S. Gov't,Oxygen / blood,Physical Stimulation / methods,PMC1395356,pmid:16280594,Psychomotor Performance / physiology,Psychophysics / methods,PubMed Abstract,Research Support,Richard E Passingham,Touch / physiology*,Visual Perception / physiology*},
  file = {C:\Users\gross\Zotero\storage\5YFANQQF\full-text.pdf}
}

