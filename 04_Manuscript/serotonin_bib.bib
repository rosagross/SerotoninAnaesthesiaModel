}

@techreport{halsbandRolePremotorParietal1982,
  title = {The Role of Premotor and Parietal Cortex in the Direction of Action},
  author = {Halsband, U. and Passingham, R.},
  year = 1982,
  volume = {240},
  number = {t982},
  pages = {372},
  abstract = {Little is known of the cortical mechanisms that ensure that the actions that an animal performs are appropriate to the external situation. Motor cortex must act on instructions from association cortex. Both premotor and parietal association cortex are in a position to exert an influence. Premotor cortex (Brodmann area 6) projects directly to motor cortex (area 4) 12,16 and superior parietal cortex (area 5) projects both to area 6 and to the supplementary motor cortexS, 9 which in turn sends connections to area 4 l{$^\circ$}. The present study examines the role these areas play by facing monkeys with a task in which they must select their actions according to the situation with which they are presented. Given one instruction they must make one response and given another instruction they must make an alternative response. 4 a b Fig. 1. a: handle for the conditional motor task. b: T-shaped manipulandum for the sequence task. The arrows indicate the direction in which the manipulandum can be moved (see text). In this study the instructions were provided by visual cues. This is a preliminary report; a fuller account will appear later. Eleven cynomolgus monkeys (Macaca fascicula-ris) were used. They were tested in a Wisconsin General Testing Apparatus. Preoperatively the animals were trained to push a vertical c61oured plaque (9 cm \texttimes{} 9 cm) to the left to uncover a hole in a perspex screen through which the animal could reach a vertical handle (Fig. la). The animals were taught to pull the handle towards them for a distance of 2.6 cm when the plaque was blue and to rotate it anticlockwise through 45 {$^\circ$} when it was yellow. Correct responses were rewarded with a peanut which the monkey obtained by opening a black plastic door. The door remained locked if the monkey made an error. A logic circuit controlled the opening of tbe door when the monkey made a correct response. On any trial either the blue or yellow plaque was presented , the order being determined by use of the Gellerman schedule. If the animal made an incorrect response the trial was repeated until the animal succeeded (re-run correction procedure). The animals were trained to a criterion of 180/200 correct trials. They completed the pre-operative acquisition training in a mean of 888 trials (506-1503) and 282 errors (139-395). Operations were performed less than 2.5 weeks after the animals reached criterion. No animal restarted testing later than 5 weeks after finishing pre-operative training. The animals were randomly assigned to 4 groups. Bilateral cortical abla-tions were made in 8 monkeys and the remaining 3 monkeys served as unoperated controls. In 3 animals the premotor cortex (PM, area 6) was removed, 0006-8993/82/0000-0000/\$02.75},
  file = {C:\Users\gross\Zotero\storage\DI8K3C3J\halsbandPassingham_1982_premotor.pdf}
}

@article{hamadaOptogeneticActivationDorsal2022,
  title = {Optogenetic Activation of Dorsal Raphe Serotonin Neurons Induces a Brain-Wide Response in Reward Network},
  author = {Hamada, Hiro Taiyo and Abe, Yoshifumi and Takata, Norio and Taira, Masakazu and Tanaka, Kenji F. and Doya, Kenji},
  year = 2022,
