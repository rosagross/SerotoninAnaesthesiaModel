  publisher = {Cambridge University Press},
  issn = {00485772},
  doi = {10.1017/S0048577201393137},
  urldate = {2020-06-01},
  abstract = {{$<$}div class="abstract" data-abstract-type="normal"{$><$}p{$>$}P300 event-related brain potential (ERP) measures are affected        by target stimulus probability, the number of nontargets preceding        the target in the stimulus sequence structure, and interstimulus        interval (ISI). Each of these factors contributes to the        target-to-target interval (TTI), which also has been found to        affect P300. The present study employed a variant of the oddball        paradigm and manipulated the number of preceding nontarget stimuli        (0, 1, 2, 3) and ISI (1, 2, 4 s) in order to systematically        assess TTI effects on P300 values from auditory and visual stimuli.        Number of preceding nontargets generally produced stronger effects        than ISI in a manner suggesting that TTI determined P300 measures:        Amplitude increased as TTI increased for both auditory and visual        stimulus conditions, whereas latency tended to decrease with        increased TTI. The finding that TTI is a critical determinant        of P300 responsivity is discussed within a resource allocation        theoretical framework.{$<$}/p{$><$}/div{$>$}},
  keywords = {Event-related potential (ERP),Interstimulus interval (ISI),P300,Sequence effects,Target-to-target interval (TTI)}
}

@article{gonsalvezP300AmplitudeDetermined2002a,
  title = {P300 Amplitude Is Determined by Target-to-Target Interval},
  author = {Gonsalvez, Craig J. and Polich, John},
  year = 2002,
  journal = {Psychophysiology},
  volume = {39},
  number = {3},
  pages = {388--396},
  issn = {00485772},
  doi = {10.1017/S0048577201393137},
  abstract = {P300 event-related brain potential (ERP) measures are affected by target stimulus probability, the number of nontargets preceding the target in the stimulus sequence structure, and interstimulus interval (ISI). Each of these factors contributes to the target-to-target interval (TTI), which also has been found to affect P300. The present study employed a variant of the oddball paradigm and manipulated the number of preceding nontarget stimuli (0, 1, 2, 3) and ISI (1, 2, 4 s) in order to systematically assess TTI effects on P300 values from auditory and visual stimuli. Number of preceding nontargets generally produced stronger effects than ISI in a manner suggesting that TTI determined P300 measures: Amplitude increased as TTI increased for both auditory and visual stimulus conditions, whereas latency tended to decrease with increased TTI. The finding that TTI is a critical determinant of P300 responsivity is discussed within a resource allocation theoretical framework.},
  pmid = {12212658},
  keywords = {Event-related potential (ERP),Interstimulus interval (ISI),P300,Sequence effects,Target-to-target interval (TTI)}
}

