  issn = {15691640},
  doi = {10.1163/15691640-12341453},
  urldate = {2022-10-26},
  abstract = {This essay explores Aristotle's discovery of touch as the most universal and philosophical of the senses. It analyses his central insight in the De Anima that tactile flesh is a ``medium not an organ,'' unpacking both its metaphysical and ethical implications. The essay concludes with a discussion of how contemporary phenomenology-from Husserl to Merleau-Ponty and Irigaray-re-describes Aristotle's seminal intuition regarding the model of ``double reversible sensation. .},
  keywords = {Aristotle,Carnal hermeneutics,Merleau-Ponty,Phenomenology,Touch},
  file = {C:\Users\gross\Zotero\storage\3HVHPWIG\full-text.pdf}
}

@article{kearneyTouchRecoveringOur,
  title = {Touch : Recovering Our Most Vital Sense},
  author = {Kearney, Richard},
  pages = {202},
  urldate = {2022-10-26},
  abstract = {"Our existence is increasingly lived at a distance. As we move from flesh to image, we are in danger of losing touch with each other and ourselves. How can we combine the physical with the virtual, our embodied experience with our global connectivity? How can we come back to our senses? Richard Kearney offers a timely call for the cultivation of the basic human need to touch and be touched. He argues that touch is our most primordial sense, foundational to our individual and common selves. Kearney explores the role of touch, from ancient wisdom traditions to modern therapies. He demonstrates that a fundamental aspect of touch is interdependence, its inherently reciprocal nature, which offers a crucial corrective to our fixation with control. Making the case for the complementarity of touch and technology, this book is a passionate plea to recover a tangible sense of community and the joys of life with others"-- Introduction: Are we losing our senses? -- 1. Coming to our senses : tact, savvy, flair, insight, resonance -- 2. Philosophies of touch : from Aristotle to phenomenology -- 3. Tales of the wounded healer -- 4. Healing touch : therapies of trauma and recovery -- 5. Reclaiming touch in the age of excarnation -- Coda: Touch and the coronavirus.},
  isbn = {9780231553179}
}

