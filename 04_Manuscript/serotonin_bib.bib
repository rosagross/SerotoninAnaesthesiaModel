  title = {Neuroscience, {{Brain Imaging}}, and {{Body Image}} in {{Eating}} and {{Weight Disorders}}},
  booktitle = {Body {{Image}}, {{Eating}}, and {{Weight}}},
  author = {Gaudio, Santino and Dakanalis, Antonios and Fariello, Giuseppe and Riva, Giuseppe},
  year = 2018,
  pages = {97--111},
