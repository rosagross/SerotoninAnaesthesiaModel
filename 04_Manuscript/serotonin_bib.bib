@article{holmesBodySchemaMultisensory2004,
  title = {The Body Schema and Multisensory Representation(s) of Peripersonal Space},
  author = {Holmes, Nicholas P. and Spence, Charles},
  year = 2004,
  month = jun,
  journal = {Cognitive Processing},
  volume = {5},
  number = {2},
  pages = {94--105},
  publisher = {{Springer Science and Business Media LLC}},
  issn = {1612-4782},
  doi = {10.1007/S10339-004-0013-3/FIGURES/4},
  urldate = {2022-10-25},
  abstract = {In order to guide the movement of the body through space, the brain must constantly monitor the position and movement of the body in relation to nearby objects. The effective 'piloting' of the body to avoid or manipulate objects in pursuit of behavioural goals (Popper \& Eccles, 1977, p. 129), requires an integrated neural representation of the body (the 'body schema') and of the space around the body ('peripersonal space'). In the review that follows, we describe and evaluate recent results from neurophysiology, neuropsychology, and psychophysics in both human and non-human primates that support the existence of an integrated representation of visual, somatosensory, and auditory peripersonal space. Such a representation involves primarily visual, somatosensory, and proprioceptive modalities, operates in body part-centred reference frames, and demonstrates significant plasticity. Recent research shows that the use of tools, the viewing of one's body or body parts in mirrors, and in video-monitors, may also modulate the visuotactile representation of peripersonal space.},
  pmid = {16467906},
  keywords = {Artificial Intelligence,Behavioral Sciences,Neurosciences,Visuotactile AE},
  file = {C:\Users\gross\Zotero\storage\MS6XQUKT\full-text.pdf}
}

