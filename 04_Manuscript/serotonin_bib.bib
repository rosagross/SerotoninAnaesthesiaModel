@incollection{liao12SomatosensorySystem2020,
  title = {4.12 - {{The Somatosensory System}} of {{Primates}}},
  booktitle = {The {{Senses}}: {{A Comprehensive Reference}} ({{Second Edition}})},
  author = {Liao, Chia-Chi and Qi, Hui-Xin and Reed, Jamie L and Kaas, Jon H},
  editor = {Fritzsch, Bernd},
  year = 2020,
  pages = {180--197},
  publisher = {Elsevier},
  address = {Oxford},
  doi = {10.1016/B978-0-12-805408-6.00028-2},
  abstract = {Synopsis As a guide to further research, we review current understandings of the organizations of the somatosensory systems of primates. Tactile inputs from the hand are clearly important in all primates, but so are inputs from the teeth and tongue. While the tactile ventroposterior nucleus of the somatosensory thalamus is recognized in all studied mammals, primates have additional nuclei that are not commonly identified in other mammals. Likewise, primary and secondary somatosensory areas of cortex are found in all studied mammals, while a variable number of additional somatosensory areas have been found in different primates. Further research is needed to document apparent differences, and determine their significance.},
  isbn = {978-0-12-805409-3},
  keywords = {Afferents,Cuneate nucleus,Dermatomes,Dorsal column nuclei,Gracile nucleus,Non-human primate,Posterior parietal cortex,Receptors,Somatosensory cortex,Spinal cord,Ventroposterior nucleus}
}

