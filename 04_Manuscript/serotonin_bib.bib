@article{blankeStimulatingIllusoryOwnbody2002,
  title = {Stimulating Illusory Own-Body Perceptions},
  author = {Blanke, Olaf and Ortigue, St{\'e}phanie and Landis, Theodor and Seeck, Margitta},
  year = 2002,
