  publisher = {John Wiley \& Sons, Ltd},
  issn = {1460-9568},
  doi = {10.1111/J.1460-9568.2005.04573.X},
  urldate = {2023-02-24},
  abstract = {This study contrasts visuospatial reorienting and response selection signals in the right temporo-parietal junction (TPJ) with functional magnetic resonance imaging. The overall goal was to investigate whether spatial orienting signals and motor signals interacted or were independent in TPJ. The right TPJ showed a greater response to targets at invalidly rather than validly cued locations, but no significant modulation from the effector used to respond. We suggest that TPJ may work as a modality-independent 'circuit breaker' for the dorsal fronto-parietal attention system, directing attention to salient events and enabling a variety of responses to those events. \copyright{} The Authors (2006).},
