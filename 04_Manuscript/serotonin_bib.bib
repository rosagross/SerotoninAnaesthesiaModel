@article{baldwinRoleSerotoninDepression1995,
  title = {The Role of Serotonin in Depression and Anxiety},
  author = {Baldwin, D. and Rudge, S.},
  year = 1995,
  journal = {International Clinical Psychopharmacology},
  volume = {9},
  pages = {41--45},
  publisher = {Lippincott Williams \& Wilkins},
  address = {US},
  issn = {1473-5857},
  doi = {10.1097/00004850-199501004-00006},
  abstract = {Although many serotonin (5-hydroxytryptamine [5-HT]) receptors have been identified, the knowledge of subtypes is limited. It is known that 5-HT1A agonists are involved in the treatment of certain anxiety disorders, 5-HT1C and 5-HT{$_2$} receptor antagonists may be indicated for generalized anxiety disorder, and 5-HT1D receptor agonists are used for migraines. Recent research has identified that various abnormalities in serotonergic function are involved in the pathogenesis of depression and anxiety, thus facilitating the development of pharmacological agents with great therapeutic potential, including the selective serotonin reuptake inhibitors. These agents appear to be effective in the treatment of many anxiety states and may have greater efficacy than others in the treatment of certain affective disorders. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  keywords = {Affective Disorders,Anxiety Disorders,Drug Therapy,Serotonin},
  file = {C:\Users\gross\Zotero\storage\DVY7TY2I\1995-41376-001.html}
}

@article{ballWeightedIntegrationSuggests2017,
  title = {Weighted Integration Suggests That Visual and Tactile Signals Provide Independent Estimates about Duration.},
  author = {Ball, Danny M and Arnold, Derek H and Yarrow, Kielan},
  year = 2017,
  journal = {Journal of Experimental Psychology: Human Perception and Performance},
  volume = {43},
  number = {5},
  pages = {868--880},
  publisher = {American Psychological Association},
  address = {Yarrow, Kielan: City, University of London, Rhind Building, Northampton Square, London, United Kingdom, EC1V 0HB, kielan.yarrow.1@city.ac.uk},
  doi = {10.1037/xhp0000368},
  abstract = {Humans might possess either a single (amodal) internal clock or multiple clocks for different sensory modalities. Sensitivity could be improved by the provision of multiple signals. Such improvements can be predicted quantitatively, assuming estimates are combined by summation, a process described as optimal when summation is weighted in accordance with the variance associated with each of the initially independent estimates. This possibility was assessed for visual and tactile information regarding temporal intervals. In Experiment 1, 12 musicians and 12 nonmusicians judged durations of 300 and 600 ms, compared to test values spanning these standards. Bimodal precision increased relative to unimodal conditions, but not to the extent predicted by optimally weighted summation. In Experiment 2, 6 musicians and 6 other participants each judged 6 standards, ranging from 100 ms to 600 ms, with conflicting cues providing a measure of the weight assigned to each sensory modality. A weighted integration model best fitted these data, with musicians more likely to select near-optimal weights than nonmusicians. Overall, data were consistent with the existence of separate visual and tactile clock components at either the counter/integrator or memory stages. Independent estimates are passed to a decisional process, but not always combined in a statistically optimal fashion. (PsycInfo Database Record (c) 2020 APA, all rights reserved)},
  isbn = {1939-1277(Electronic),0096-1523(Print)},
  keywords = {*Response Duration,*Tactual Perception,*Visual Perception,Stimulus Intervals}
}

@article{balslevEnhancedAccuracyNovel2004,
  title = {Enhanced {{Accuracy}} in {{Novel Mirror Drawing}} after {{Repetitive Transcranial Magnetic Stimulation-Induced Proprioceptive Deafferentation}}},
  author = {Balslev, Daniela and Christensen, Lars O.D. and Lee, Ji Hang and Law, Ian and Paulson, Olaf B. and Miall, R. Christopher},
  year = 2004,
  month = oct,
  journal = {Journal of Neuroscience},
  volume = {24},
  number = {43},
  pages = {9698--9702},
  publisher = {Society for Neuroscience},
  issn = {0270-6474},
  doi = {10.1523/JNEUROSCI.1738-04.2004},
  urldate = {2022-10-13},
  abstract = {When performing visually guided actions under conditions of perturbed visual feedback, e.g., in a mirror or a video camera, there is a spatial conflict between visual and proprioceptive information. Recent studies have shown that subjects without proprioception avoid this conflict and show a performance benefit. In this study, we tested whether deafferentation induced by repetitive transcranial magnetic stimulation (rTMS) can improve mirror tracing skills in normal subjects. Hand trajectory error during novel mirror drawing was compared across two groups of subjects that received either 1 Hz rTMS over the somatosensory cortex contralateral to the hand or sham stimulation. Mirror tracing was more accurate after rTMS than after sham stimulation. Using a position-matching task, we confirmed that rTMS reduced proprioceptive acuity and that this reduction was largest when the coil was placed at an anterior parietal site. It is thus possible, with rTMS, to enhance motor performance in tasks involving a visuoproprioceptive conflict, presumably by reducing the excitability of somatosensory cortical areas that contribute to the sense of hand position.},
  pmid = {15509758},
  keywords = {,Hand,Motor activity,Parietal,Proprioceptive,Somatosensory,Visual},
  file = {C:\Users\gross\Zotero\storage\6SD2NLHX\full-text.pdf}
}

