\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Histology. \textbf  {(a)} Coronal slices of channelrhodopsin expression in the DRN for all seven SERT-cre mice. The first five mice, labeled in green, show expression of channelrhodopsin in the DRN as indicated by fluorescence directly underneath the ventricle. The last two mice, labeled in gray, do not show any expression due to a failed virus injection. \textbf  {(b)} Fluorescent tracts of Neuropixel insertions. Neuropixels are dipped in Di-I resulting in a red fluorescent trace in the histology. Coronal slices at four different anterior-posterior positions are shown.}}{10}{figure.caption.5}\protected@file@percent }
\newlabel{suppfig:histology}{{S1}{10}{Histology. \textbf {(a)} Coronal slices of channelrhodopsin expression in the DRN for all seven SERT-cre mice. The first five mice, labeled in green, show expression of channelrhodopsin in the DRN as indicated by fluorescence directly underneath the ventricle. The last two mice, labeled in gray, do not show any expression due to a failed virus injection. \textbf {(b)} Fluorescent tracts of Neuropixel insertions. Neuropixels are dipped in Di-I resulting in a red fluorescent trace in the histology. Coronal slices at four different anterior-posterior positions are shown}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces No light-evoked effect on neural activity in mice lacking channelrhodopsin expression. \textbf  {(a)} The percentage of neurons which are significantly modulated by light delivery to the DRN. Each dot is a mouse, separated by whether that mouse expressed channelrhodopsin the DRN or not. \textbf  {(b)} The percentage of light-modulated neurons in mice lacking channelrhodopsin expression, split out per brain region. Each dot is a recording session. \textbf  {(c)} A very small decrease in DOWN state probability compared to baseline (-1 to 0s) was found in one time point during light delivery to the DRN (blue vertical bar). Data from all brain regions are pooled. Black horizontal bar above the plot indicates the significant time point (t-test versus 0, \emph  {p} = 0.046).}}{11}{figure.caption.6}\protected@file@percent }
\newlabel{suppfig:no_expression}{{S2}{11}{No light-evoked effect on neural activity in mice lacking channelrhodopsin expression. \textbf {(a)} The percentage of neurons which are significantly modulated by light delivery to the DRN. Each dot is a mouse, separated by whether that mouse expressed channelrhodopsin the DRN or not. \textbf {(b)} The percentage of light-modulated neurons in mice lacking channelrhodopsin expression, split out per brain region. Each dot is a recording session. \textbf {(c)} A very small decrease in DOWN state probability compared to baseline (-1 to 0s) was found in one time point during light delivery to the DRN (blue vertical bar). Data from all brain regions are pooled. Black horizontal bar above the plot indicates the significant time point (t-test versus 0, \emph {p} = 0.046)}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces The magnitude of 5-HT induced suppression of neural activity is significantly correlated with 5-HT2a receptor expression. For each brain region, at a more granular delineation compared to the main figures, the expression strength of 5-HT2a was obtained from the Allen Brain Atlas. The modulation index of all neurons in each brain region was averaged. Each dot is a brain region. * \emph  {p} = 0.01, Pearson correlation.}}{12}{figure.caption.7}\protected@file@percent }
\newlabel{suppfig:receptor_expression}{{S3}{12}{The magnitude of 5-HT induced suppression of neural activity is significantly correlated with 5-HT2a receptor expression. For each brain region, at a more granular delineation compared to the main figures, the expression strength of 5-HT2a was obtained from the Allen Brain Atlas. The modulation index of all neurons in each brain region was averaged. Each dot is a brain region. * \emph {p} = 0.01, Pearson correlation}{figure.caption.7}{}}
