\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Histology. \textbf  {(a)} Coronal slices of channelrhodopsin expression in the DRN for all seven SERT-cre mice. The first five mice, labeled in green, show expression of channelrhodopsin in the DRN as indicated by fluorescence directly underneath the ventricle. The last two mice, labeled in gray, do not show any expression due to a failed virus injection. \textbf  {(b)} Fluorescent tracts of Neuropixel insertions. Neuropixels are dipped in Di-I resulting in a red fluorescent trace in the histology. Coronal slices at four different anterior-posterior positions are shown.}}{13}{figure.caption.5}\protected@file@percent }
\newlabel{suppfig:histology}{{S1}{13}{Histology. \textbf {(a)} Coronal slices of channelrhodopsin expression in the DRN for all seven SERT-cre mice. The first five mice, labeled in green, show expression of channelrhodopsin in the DRN as indicated by fluorescence directly underneath the ventricle. The last two mice, labeled in gray, do not show any expression due to a failed virus injection. \textbf {(b)} Fluorescent tracts of Neuropixel insertions. Neuropixels are dipped in Di-I resulting in a red fluorescent trace in the histology. Coronal slices at four different anterior-posterior positions are shown}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces No light-evoked effect on neural activity in mice lacking channelrhodopsin expression. \textbf  {(a)} The percentage of neurons which are significantly modulated by light delivery to the DRN. Each dot is a mouse, separated by whether that mouse expressed channelrhodopsin the DRN or not. \textbf  {(b)} The percentage of light-modulated neurons in mice lacking channelrhodopsin expression, split out per brain region. Each dot is a recording session. \textbf  {(c)} A very small decrease in DOWN state probability compared to baseline (-1 to 0s) was found in one time point during light delivery to the DRN (blue vertical bar). Data from all brain regions are pooled. Black horizontal bar above the plot indicates the significant time point (t-test versus 0, \emph  {p} = 0.046).}}{14}{figure.caption.6}\protected@file@percent }
\newlabel{suppfig:no_expression}{{S2}{14}{No light-evoked effect on neural activity in mice lacking channelrhodopsin expression. \textbf {(a)} The percentage of neurons which are significantly modulated by light delivery to the DRN. Each dot is a mouse, separated by whether that mouse expressed channelrhodopsin the DRN or not. \textbf {(b)} The percentage of light-modulated neurons in mice lacking channelrhodopsin expression, split out per brain region. Each dot is a recording session. \textbf {(c)} A very small decrease in DOWN state probability compared to baseline (-1 to 0s) was found in one time point during light delivery to the DRN (blue vertical bar). Data from all brain regions are pooled. Black horizontal bar above the plot indicates the significant time point (t-test versus 0, \emph {p} = 0.046)}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {(a)} No significant correlation between the projection strength from the dorsal raphe nucleus (DRN) with the magnitude of 5-HT induced suppression of neural activity. For each brain region, at a more granular delineation compared to the main figures, the projection density from the DRN was obtained from the Allen Brain Atlas. The modulation index of all neurons in each brain region was averaged. Each dot is a brain region. \textbf  {(b)} There was a significant correlation for the expression strength of 5-HT1f receptors with 5-HT induced functional modulation at a region-by-region level. \textbf  {(c)} Same as (b) for 5-HT2a receptor expression. \textbf  {(d)} Same as (b) for 5-HT2c receptor expression. All stats done with a Pearson correlation.}}{15}{figure.caption.7}\protected@file@percent }
\newlabel{suppfig:receptor_expression}{{S3}{15}{\textbf {(a)} No significant correlation between the projection strength from the dorsal raphe nucleus (DRN) with the magnitude of 5-HT induced suppression of neural activity. For each brain region, at a more granular delineation compared to the main figures, the projection density from the DRN was obtained from the Allen Brain Atlas. The modulation index of all neurons in each brain region was averaged. Each dot is a brain region. \textbf {(b)} There was a significant correlation for the expression strength of 5-HT1f receptors with 5-HT induced functional modulation at a region-by-region level. \textbf {(c)} Same as (b) for 5-HT2a receptor expression. \textbf {(d)} Same as (b) for 5-HT2c receptor expression. All stats done with a Pearson correlation}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Nullclines of one isolated area containing one excitatory and one inihibitory population. \textbf  {(a)} Excitatory external input (I+) to the inhibitory population with equal strength did not lead to the same DOWN state transition like inhibitory external input (I-) to the excitatory population. \textbf  {(b)} Phase planes as in (a) for inhibitory input (I-).}}{16}{figure.caption.8}\protected@file@percent }
\newlabel{suppfig:serotonin_stimulation_mechanism}{{S4}{16}{Nullclines of one isolated area containing one excitatory and one inihibitory population. \textbf {(a)} Excitatory external input (I+) to the inhibitory population with equal strength did not lead to the same DOWN state transition like inhibitory external input (I-) to the excitatory population. \textbf {(b)} Phase planes as in (a) for inhibitory input (I-)}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Robustness of DRN projection density correlations. \textbf  {(a)} Leave-one-out analysis of the correlation between DRN projection density and DOWN state probability in the uncoupled network ($G$=0; corresponds to Fig.~\ref {fig:model_updown}f, left). Each bar shows the Pearson correlation \emph  {p}-value obtained after excluding the labeled brain region from the correlation. The correlation remained significant regardless of which region was excluded (significance threshold \emph  {p}=0.05). \textbf  {(b)} Same as (a) for the coupled network ($G$=3; Fig.~\ref {fig:model_updown}f, right). Excluding several regions, most notably the amygdala, dominates the correlation, showing that this correlation. \textbf  {(c)} The absolute change in DOWN state probability between the uncoupled (G=0) and coupled network (G=3) ($\Delta $ down state per region, as in Fig.~\ref {fig:model_updown}h) plotted against DRN projection density. There was no significant correlation (Pearson correlation, \emph  {r}=-0.25, \emph  {p}=0.56).}}{17}{figure.caption.9}\protected@file@percent }
\newlabel{suppfig:correlation_robustness}{{S5}{17}{Robustness of DRN projection density correlations. \textbf {(a)} Leave-one-out analysis of the correlation between DRN projection density and DOWN state probability in the uncoupled network ($G$=0; corresponds to Fig.~\ref {fig:model_updown}f, left). Each bar shows the Pearson correlation \emph {p}-value obtained after excluding the labeled brain region from the correlation. The correlation remained significant regardless of which region was excluded (significance threshold \emph {p}=0.05). \textbf {(b)} Same as (a) for the coupled network ($G$=3; Fig.~\ref {fig:model_updown}f, right). Excluding several regions, most notably the amygdala, dominates the correlation, showing that this correlation. \textbf {(c)} The absolute change in DOWN state probability between the uncoupled (G=0) and coupled network (G=3) ($\Delta $ down state per region, as in Fig.~\ref {fig:model_updown}h) plotted against DRN projection density. There was no significant correlation (Pearson correlation, \emph {r}=-0.25, \emph {p}=0.56)}{figure.caption.9}{}}
